# ============================================================
# MuscleApp — environment variables (template)
# Copy to `.env` and adjust. NEVER commit a `.env` with real secrets.
# ============================================================

# ---- App ----
APP_ENV=development           # development | test | production
APP_NAME=MuscleApp
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                # true in production (structured logs)

# ---- CORS (comma-separated allowlist) ----
CORS_ORIGINS=http://localhost:5173

# ---- Database (Postgres + pgvector) ----
POSTGRES_USER=muscle
POSTGRES_PASSWORD=muscle_dev_pw
POSTGRES_DB=muscle
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL is composed from the values above in config.py

# ---- LLM provider (provider-agnostic) ----
LLM_PROVIDER=stub             # stub (no setup) | ollama (local) | gemini | groq (deploy)
LLM_MODEL=llama3.1
# Ollama (dev)
OLLAMA_BASE_URL=http://ollama:11434
# Gemini — free tier (used for embeddings in deploy)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq — OpenAI-compatible, generous free tier, no card (chat LLM in deploy)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Embeddings ----
EMBEDDING_PROVIDER=fake       # fake (no setup) | jina (API, deploy default) | gemini (API) | sentence_transformers (.[ai])
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Jina AI (jina.ai, free tier, no card). Preferred in deploys: Google's free
# tier rejects datacenter IPs ("User location is not supported") — see ADR-0019.
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
# Set to true for ONE boot after switching embedding model/provider: it clears
# the stored vectors so they are recomputed (vectors of different models are not
# comparable). Leave false otherwise.
EMBEDDING_REBUILD=false

# --- Cache (query embeddings) ---
CACHE_PROVIDER=memory         # memory (in-process, zero setup) | redis
# IMPORTANT: managed providers such as Upstash require TLS — use rediss:// (two
# s). A plain redis:// URL fails to connect and only degrades to no cache.
REDIS_URL=

# ---- Observability (optional) ----
SENTRY_DSN=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
